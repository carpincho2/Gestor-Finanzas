  "common_ocr_errors": [
    {
      "pattern": "0O",
      "replacements": ["00", "O0"],
      "context": "El cero y la O mayúscula se confunden frecuentemente",
      "example": "TATAL 27.0O debe ser TOTAL 27.00"
    },
    {
      "pattern": "1lIL",
      "replacements": ["1", "i", "l"],
      "context": "El uno, la L mayúscula, la I mayúscula y la l minúscula se confunden",
      "example": "HORA 18:3l debe ser HORA 18:31"
    },
    {
      "pattern": "rnm",
      "replacements": ["rn", "m"],
      "context": "La eme y rn se pueden confundir por similitud visual",
      "example": "MONTO puede leerse como IVIONTO"
    },
    {
      "pattern": "58",
      "replacements": ["5", "8"],
      "context": "Confusión en tickets borrosos",
      "example": "2850 puede leerse como 2550"
    },
    {
      "pattern": "SZ",
      "replacements": ["S", "Z"],
      "context": "La S y la Z pueden confundirse",
      "example": "PIZZERIA puede leerse como PIZERIA"
    }
  ],

  "realistic_amounts": {
    "min_argentina": 10,
    "max_argentina": 100000,
    "description": "Rango realista de gastos en pesos argentinos (ARS)"
  },

  "date_formats_argentina": [
    { "format": "DD/MM/YYYY", "example": "28/05/2026", "regex": "(?:0[1-9]|[12][0-9]|3[01])/(?:0[1-9]|1[012])/\\d{4}" },
    { "format": "DD-MM-YYYY", "example": "28-05-2026", "regex": "(?:0[1-9]|[12][0-9]|3[01])-(?:0[1-9]|1[012])-\\d{4}" },
    { "format": "DD.MM.YYYY", "example": "28.05.2026", "regex": "(?:0[1-9]|[12][0-9]|3[01])\\.(?:0[1-9]|1[012])\\.\\d{4}" }
  ],

  "time_formats_argentina": [
    { "format": "HH:MM", "example": "14:35", "regex": "(?:[01][0-9]|2[0-3]):[0-5][0-9]" },
    { "format": "HH:MM:SS", "example": "14:35:42", "regex": "(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]" }
  ],

  "currency_settings": {
    "argentina": {
      "symbol": "$",
      "decimal_separator": ",",
      "thousands_separator": ".",
      "position": "prefix",
      "example": "$ 1.234,50"
    }
  },

  "validation_rules": {
    "store_name": {
      "min_length": 3,
      "max_length": 80,
      "must_contain_letters": true,
      "reject_patterns": [
        "^\\d+$",
        "^[^a-záéíóúñA-ZÁÉÍÓÚÑ]*$",
        "[fjwkqb]{3,}",
        "\\d{2,}[a-z]{2,}"
      ]
    },
    "amount": {
      "min": 10,
      "max": 100000,
      "must_be_positive": true,
      "decimal_places_max": 2
    },
    "date": {
      "not_in_future": true,
      "not_older_than_days": 3650,
      "prefer_recent": true
    }
  },

  "confidence_thresholds": {
    "high": { "min": 85, "label": "Muy seguro", "color": "#00e5a0", "action": "accept" },
    "medium": { "min": 50, "max": 85, "label": "Revisar", "color": "#ffb84a", "action": "review" },
    "low": { "min": 0, "max": 50, "label": "Editar", "color": "#ff6b4a", "action": "reject" }
  },

  "debug_levels": [
    { "level": 0, "name": "OFF", "description": "Sin debug" },
    { "level": 1, "name": "ERROR", "description": "Solo errores" },
    { "level": 2, "name": "WARN", "description": "Errores y advertencias" },
    { "level": 3, "name": "INFO", "description": "Información general" },
    { "level": 4, "name": "DEBUG", "description": "Todos los logs incluyendo internos" },
    { "level": 5, "name": "TRACE", "description": "Traza completa de ejecución" }
  ]
}
