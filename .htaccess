# Flujo Finance Manager — Apache config (LEGACY)
# NOTA: Este archivo es legacy de una arquitectura anterior basada en PHP/Apache.
# El proyecto actual usa FastAPI + Uvicorn. Este archivo no tiene efecto.
Options -Indexes

# PHP: mostrar errores solo en dev (comentar en producción)
<IfModule mod_php.c>
    php_flag  display_errors  Off
    php_value error_reporting 0
</IfModule>
