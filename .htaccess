# Flujo Finance Manager — Apache config
Options -Indexes

# Servir módulos .ts como JavaScript ejecutable en navegadores (evita MIME video/mp2t)
<IfModule mod_mime.c>
    AddType application/javascript .ts
</IfModule>

# PHP: mostrar errores solo en dev (comentar en producción)
<IfModule mod_php.c>
    php_flag  display_errors  Off
    php_value error_reporting 0
</IfModule>
